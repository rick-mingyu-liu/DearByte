{
  "name": "dearbyte",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "companion": "tsx src/cli.ts",
    "dearbyte": "tsx src/dearbyte.ts",
    "bakeoff": "tsx tools/bakeoff.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent:smoke": "tsx --env-file-if-exists=.env tools/agent-smoke.ts",
    "agent:usage": "tsx tools/agent-usage.ts",
    "agent": "tsx src/agent-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
